# SeedInfer Modal — env dla setup-all-accounts.sh
# Skopiuj do infra/modal/.env i dostosuj (opcjonalnie — skrypt i tak czyta ~/.modal.toml automatycznie)

# Lista profili do deploy — domyślnie wszystkie z ~/.modal.toml (grep '^\[.+\]')
# Odkomentuj aby ograniczyć:
# MODAL_PROFILES="konwsermetaliciezkich jasionka-kuba modalacc1"

# Alternatywnie pojedynczy profil:
# MODAL_PROFILE=konwsermetaliciezkich

# App name (musiałbyś zmienić też w py)
# MODAL_APP_NAME=seedinfer-nemotron-vllm

# Volumes
# MODAL_HF_VOLUME=seedinfer-hf-cache
# MODAL_MODEL_VOLUME=seedinfer-model-cache

# Deploy mode: deploy | build-only
# MODAL_MODE=deploy

# Profile list (auto-detect 10):
# - konwsermetaliciezkich (active, ak-ReyuSWj3WGIyFtlodTkziE)
# - jasionka-kuba
# - mokraolazpornola (auth failure — wymaga token refresh)
