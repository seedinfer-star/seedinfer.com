# SeedInfer.com — Caddy snippet — Tailnet Headscale
# Wklej zawartość tego pliku do Caddyfile (root / infra/Caddyfile) LUB zaimportuj:
#   import /etc/caddy/Caddy.tailnet.snippet  (gdy Caddy w Dockerze mount jako volume)
# Publiczny dostęp: https://tailnet.seedinfer.com -> Cloudflare Tunnel -> Caddy :80 -> 127.0.0.1:8080 (Headscale)
# Lokalnie na Pi: http://127.0.0.1:8080 (Headscale direct, bez Caddy)
#
# Wymagania:
# - Headscale musi słuchać na 127.0.0.1:8080 (infra/headscale/config.yaml)
# - Caddy musi mieć ten blok PRZED :80 fallback (kolejność ma znaczenie — longest match)
# - Dla Docker Caddy: jeśli Headscale jest w osobnym compose, użyj host.docker.internal:8080
#   i dodaj w docker-compose.yml caddy: extra_hosts: ["host.docker.internal:host-gateway"]
# - Dla bare-metal Caddy: zostaw 127.0.0.1:8080

tailnet.seedinfer.com {
	encode zstd gzip

	# Security headers (łagodniejsze niż dla seedinfer.com — Headscale ma własne API)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Headscale API wymaga CORS dla Tailscale clients — nie wymuszamy CSP tutaj
	}

	# Healthcheck — odpowiada Caddy bez proxy (szybki check czy Caddy żyje)
	# Prawdziwy health Headscale to GET /health proxied poniżej; ten jest dla Caddy liveness
	@health path /health /healthz
	handle @health {
		respond "ok" 200
	}

	# Headscale — reverse proxy do Go (127.0.0.1:8080)
	# Docker bridge: jeśli Caddy i Headscale w różnych compose, zmień na host.docker.internal:8080
	#   i dodaj: extra_hosts: ["host.docker.internal:host-gateway"] w docker-compose.yml caddy
	handle {
		reverse_proxy 127.0.0.1:8080 {
			# Docker alternatywa (w jednym docker network: headscale:8080):
			# to headscale:8080
			# Bare-metal alternatywa już ustawiona: 127.0.0.1:8080

			header_up Host {host}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up Upgrade {http.request.header.Upgrade}
			header_up Connection {http.request.header.Connection}

			# Timeouts — Headscale jest lekki, ale za Cloudflare może być latency
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
				keepalive_interval 30s
			}

			# Health check upstream (Caddy active health)
			health_uri /health
			health_interval 30s
			health_timeout 5s
		}
	}

	# Opcjonalnie: Headscale-UI pod /admin (jeśli włączysz serwis headscale-ui na :3001)
	# handle /admin/* {
	# 	reverse_proxy 127.0.0.1:3001
	# }

	log {
		output stdout
		format json
		level INFO
	}
}
