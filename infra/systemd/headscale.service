[Unit]
Description=Headscale — SeedInfer.com Tailnet (Faza 0, Orange Pi 4 Pro RK3588)
Documentation=https://github.com/juanfont/headscale https://seedinfer.com/docs/tailnet.md
After=network.target network-online.target
Wants=network-online.target
# NVMe musi być zamontowane przed startem (DB na /mnt/nvme/headscale)
RequiresMountsFor=/mnt/nvme

[Service]
Type=simple
User=headscale
Group=headscale
# Binary ARM64: /usr/bin/headscale (pobrane z GitHub releases 0.25.1 linux_arm64)
ExecStart=/usr/bin/headscale serve
Restart=always
RestartSec=5
# Config na /etc/headscale (kopiowane z repo: infra/headscale/config.yaml -> /etc/headscale/config.yaml)
# DB na NVMe: /mnt/nvme/headscale/db.sqlite (config.yaml: db_path: /mnt/nvme/headscale/db.sqlite)
Environment=HEADSCALE_CONFIG=/etc/headscale/config.yaml
# Alternatywnie: --config /etc/headscale/config.yaml jeśli binary wspiera flagę

# Working dir — logi i tmp
WorkingDirectory=/etc/headscale

# Hardening (Pi bare-metal)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/headscale /mnt/nvme/headscale /var/log/headscale
ProtectHome=read-only
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Limity — Headscale lekki (<100MB), RK3588 8GB
MemoryMax=512M
CPUWeight=100

# Logi -> journalctl -u headscale
StandardOutput=journal
StandardError=journal
SyslogIdentifier=headscale

[Install]
WantedBy=multi-user.target
