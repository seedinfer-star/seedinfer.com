# SeedInfer Provider — CUDA (rtx5090 / NVFP4 production)
# Base: Official vllm-openai nightly image (includes pre-compiled CUDA/C++ FlashInfer & TRT-LLM binaries)
FROM vllm/vllm-openai:nightly

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    HF_HOME=/root/.cache/huggingface \
    VLLM_USE_V1=0 \
    VLLM_ATTENTION_BACKEND=FLASHINFER \
    VLLM_NVFP4_GEMM_BACKEND=flashinfer-cutlass \
    VLLM_USE_FLASHINFER_MOE_FP4=1 \
    VLLM_USE_FLASHINFER_SAMPLER=1 \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1

WORKDIR /app

# Install lightweight agent dependencies onto the pre-baked vLLM environment
RUN pip install --break-system-packages --no-cache-dir fastapi uvicorn requests psutil pydantic pydantic-settings websockets httpx 2>/dev/null || true

# Copy agent code and assets
COPY provider/agent /app/agent
RUN chmod +x /app/agent/entrypoint.sh 2>/dev/null || true

# Assets
COPY provider/assets/nemotron_lightning_chat_template_nothink2.jinja /qwen_setup/nemotron_lightning_chat_template_nothink2.jinja
COPY provider/assets/nemotron3_tool_parser_plugin.py /qwen_setup/nemotron3_tool_parser_plugin.py

EXPOSE 8000 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:3001/health | grep -q '"status":"ok"' || exit 1

ENTRYPOINT ["/bin/bash", "/app/agent/entrypoint.sh"]
