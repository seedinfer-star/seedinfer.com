# SeedInfer Provider — .env.example — host 1:1 RTX 5090 32GB GB202 (jakub-b550m)
# Skopiuj do .env i uzupełnij. Nie commituj realnego .env.
# Host docker run reference:
# docker run -d --gpus all --ipc=host -e VLLM_ATTENTION_BACKEND=FLASHINFER -e VLLM_NVFP4_GEMM_BACKEND=flashinfer-cutlass -e VLLM_USE_FLASHINFER_MOE_FP4=1 -e VLLM_USE_FLASHINFER_SAMPLER=1 -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False -e VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 -e HF_HUB_OFFLINE=1 -e HF_HOME=/tmp/hf_home --entrypoint /qwen_setup/patch_and_run.sh ... --quantization modelopt --dtype bfloat16 --kv-cache-dtype fp8 --max-model-len 1048576 --gpu-memory-utilization 0.93 --max-num-seqs 128 --max-num-batched-tokens 4096 --enable-chunked-prefill --enable-prefix-caching --moe-backend marlin --mamba-backend flashinfer --mamba-cache-mode align --chat-template /mnt/d/qwen_setup/nemotron_lightning_chat_template_nothink2.jinja --enable-auto-tool-choice --tool-call-parser nemotron3 --tool-parser-plugin /mnt/d/qwen_setup/nemotron3_tool_parser_plugin.py --trust-remote-code --language-model-only

# --- Gateway ---
SEEDINFER_GATEWAY_URL=https://seedinfer.com
PROVIDER_API_KEY=
SEEDINFER_API_KEY=

# --- Tailnet (Headscale) ---
TAILSCALE_AUTHKEY=hskey-provider-xxx
TAILSCALE_LOGIN_SERVER=https://tailnet.seedinfer.com
TAILSCALE_HOSTNAME=provider-5090
TAILSCALE_EXTRA_ARGS=--accept-routes

# --- Model / vLLM — NVFP4 (Faza 0 plug-and-play) host 1:1 ---
MODEL=seedinfer/nemotron-lightning-1m
VLLM_MODEL=nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4
HF_TOKEN=
VLLM_PORT=47900 # host 47900 -> container 8000 (wolny, nie koliduje z 3000/3002/8004-8007). Można nadpisać env.
# Host 0.93 dla 32GB (RTX 5090, Blackwell, L40S, 6000 Ada etc) — nie 0.90
VLLM_GPU_MEMORY_UTILIZATION=0.93
VLLM_MAX_MODEL_LEN=1048576
VLLM_DTYPE=bfloat16
VLLM_ENABLE_PREFIX_CACHING=true
# Host: modelopt (nie modelopt_fp4, nie auto) — ModelOpt NVFP4 stored precision via compressed-tensors
VLLM_QUANTIZATION=modelopt
# Host: fp8 (nie auto) — KV cache dtype explicit
VLLM_KV_CACHE_DTYPE=fp8
# Dodatkowe flagi vLLM — host: nemotron3 + marlin + flashinfer + plugin (entrypoint injects chat-template/plugin if exists)
# Zostaw puste = entrypoint użyje host defaults (--enable-auto-tool-choice --tool-call-parser nemotron3 + --tool-parser-plugin /qwen_setup/... + --moe-backend marlin)
VLLM_EXTRA_ARGS=
# MoE / Mamba — host defaults dla 32GB (można nadpisać: A100/H100 fallback → humming)
VLLM_MOE_BACKEND=marlin
VLLM_MAMBA_BACKEND=flashinfer
VLLM_MAMBA_CACHE_MODE=align
# Chat template / plugin — host path via /qwen_setup:ro (fallback ./provider/assets)
VLLM_CHAT_TEMPLATE=/qwen_setup/nemotron_lightning_chat_template_nothink2.jinja
VLLM_TOOL_PARSER_PLUGIN=/qwen_setup/nemotron3_tool_parser_plugin.py
# NVFP4 FLASHINFER envs — host 1:1 (nie zmieniaj chyba że debug)
VLLM_ATTENTION_BACKEND=FLASHINFER
VLLM_NVFP4_GEMM_BACKEND=flashinfer-cutlass
VLLM_USE_FLASHINFER_MOE_FP4=1
VLLM_USE_FLASHINFER_SAMPLER=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
HF_HUB_OFFLINE=0 # host offline test: 1 (HF_HOME=/tmp/hf_home), provider online: 0 (HF_HOME=/root/.cache/huggingface)
HF_HOME=/root/.cache/huggingface

# --- Agent ---
AGENT_PORT=47901 # host 47901 -> container 3001 (wolny). Można nadpisać env.
AGENT_LOG_LEVEL=info
PROVIDER_ID=
PROVIDER_REGION=pl-central
VLLM_URL=http://127.0.0.1:8000 # wewnętrzny 8000, host mapping tylko 47900:8000

# --- Storage ---
HF_CACHE_HOST=./models/cache
MODELS_HOST=./models
