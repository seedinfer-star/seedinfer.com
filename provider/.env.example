# SeedInfer Provider — .env.example — host 1:1 RTX 5090 32GB GB202 (jakub-b550m)
# Skopiuj do .env i uzupełnij. Nie commituj realnego .env.
# Host docker run reference 1:1 z DiffusionGemma Studio:
# docker run -d --name "$CONTAINER" \
#   --gpus all \
#   -v /mnt/d:/mnt/d:ro \
#   -v /mnt/d/models/hf:/models:ro \
#   -v "/mnt/d/Desktop/DiffusionGemma Studio/gemma4_chat_template.jinja:/tmp/gemma4_chat_template.jinja:ro" \
#   -p $PORT_HOST:$PORT_CONT \
#   --ipc=host \
#   --restart unless-stopped \
#   -e VLLM_USE_V2_MODEL_RUNNER=1 \
#   -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
#   -e VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
#   -e HF_HUB_OFFLINE=1 \
#   -e HF_HOME=/tmp/hf_home \
#   "$IMAGE" \
#   --model /models/Gemma-4-26B-A4B-NVFP4 \
#   --hf-overrides '{"architectures": ["Gemma4ForCausalLM"]}' \
#   --quantization modelopt \
#   --dtype bfloat16 \
#   --kv-cache-dtype fp8 \
#   --gpu-memory-utilization 0.94 \
#   --block-size 16 \
#   --max-model-len 262144 \
#   --max-num-seqs 32 \
#   --max-cudagraph-capture-size 32 \
#   --cudagraph-capture-sizes 1 2 4 8 16 32 \
#   --enable-chunked-prefill \
#   --enable-prefix-caching \
#   --max-num-batched-tokens 4096 \
#   --scheduling-policy priority

# --- Gateway ---
SEEDINFER_GATEWAY_URL=https://seedinfer.com
PROVIDER_API_KEY=
SEEDINFER_API_KEY=

# --- Tailnet (Headscale) ---
TAILSCALE_AUTHKEY=hskey-provider-xxx
TAILSCALE_LOGIN_SERVER=https://tailnet.seedinfer.com
TAILSCALE_HOSTNAME=provider-5090
TAILSCALE_EXTRA_ARGS=--accept-routes

# --- Model / vLLM — Gemma 4 26B A4B NVFP4 ---
MODEL=google/gemma-4-26b-a4b-nvfp4
VLLM_MODEL=/models/Gemma-4-26B-A4B-NVFP4
HF_TOKEN=
VLLM_PORT=47900 # host 47900 -> container 8000
VLLM_GPU_MEMORY_UTILIZATION=0.94
VLLM_MAX_MODEL_LEN=262144
VLLM_MAX_NUM_SEQS=32
VLLM_MAX_BATCHED_TOKENS=4096
VLLM_BLOCK_SIZE=16
VLLM_MAX_CUDAGRAPH_CAPTURE_SIZE=32
VLLM_CUDAGRAPH_CAPTURE_SIZES="1 2 4 8 16 32"
VLLM_CPU_OFFLOAD_GB=0
VLLM_SWAP_SPACE=0
VLLM_DTYPE=bfloat16
VLLM_ENABLE_PREFIX_CACHING=true
VLLM_ENABLE_CHUNKED_PREFILL=true
VLLM_SCHEDULING_POLICY=priority
VLLM_QUANTIZATION=modelopt
VLLM_KV_CACHE_DTYPE=fp8
VLLM_EXTRA_ARGS=
VLLM_MOE_BACKEND=marlin
VLLM_MAMBA_BACKEND=flashinfer
VLLM_MAMBA_CACHE_MODE=align
VLLM_CHAT_TEMPLATE=/qwen_setup/gemma4_chat_template.jinja

# Engine & Backend settings (1:1 z DiffusionGemma Studio)
VLLM_USE_V2_MODEL_RUNNER=1
VLLM_ATTENTION_BACKEND=FLASHINFER
VLLM_NVFP4_GEMM_BACKEND=flashinfer-cutlass
VLLM_USE_FLASHINFER_MOE_FP4=1
VLLM_USE_FLASHINFER_SAMPLER=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
HF_HUB_OFFLINE=0
HF_HOME=/root/.cache/huggingface

# --- Agent ---
AGENT_PORT=47901 # host 47901 -> container 3001
AGENT_LOG_LEVEL=info
PROVIDER_ID=
PROVIDER_REGION=pl-central
VLLM_URL=http://127.0.0.1:8000

# --- Storage ---
HF_CACHE_HOST=./models/cache
MODELS_HOST=/mnt/d/models/hf
