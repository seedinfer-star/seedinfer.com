# SeedInfer.com — .env.example — Orange Pi 4 Pro
# Skopiuj do .env (bare-metal: /opt/seedinfer/.env) i .env.local (dev)
# Nigdy nie commituj realnego .env — tylko .env.example

# --- Frontend ---
NODE_ENV=production
PORT=3000
# Publiczne API — jeśli zostawisz puste, frontend użyje /api/stats (Next Route Handler -> https://api.darkbloom.dev/v1/stats)
NEXT_PUBLIC_API_URL=
# Alternatywa: własne API na tym samym Pi / NextCloud
# NEXT_PUBLIC_API_URL=https://seedinfer.com/api/stats

# Faza0 filter — parity mode domyślnie false (przepuszczaj 8 modeli DarkBloom bez modyfikacji)
# NEXT_PUBLIC_FAZA0_ENABLED=false
# Gdy true → filtruj tylko Nemotron Lightning (Faza 0), ?faza0=1 wymusza per-request

# Upstream (serwerowy, nie publiczny) — używany w app/api/stats/route.ts
# UPSTREAM=https://api.darkbloom.dev/v1/stats

# --- Wallety (Transparency footer) — opcjonalnie nadpisują placeholdery w components/transparency-footer.tsx ---
# EVM same address on 6 chains + Solana separate — 7 chains total
NEXT_PUBLIC_PAYMENT_ADDRESS=0x2EB9104AEeF7270fe639Bf1965B94Bfb8Edcf786
NEXT_PUBLIC_EVM_ADDRESS=0x2EB9104AEeF7270fe639Bf1965B94Bfb8Edcf786
NEXT_PUBLIC_BASE_ADDRESS=0x2EB9104AEeF7270fe639Bf1965B94Bfb8Edcf786
NEXT_PUBLIC_SOL_ADDRESS=So11111111111111111111111111111111111111112
NEXT_PUBLIC_SOLANA_ADDRESS=So11111111111111111111111111111111111111112

# --- Cloudflare Tunnel ---
# Token z Dashboard: Zero Trust -> Networks -> Tunnels -> seedinfer -> Configure -> Install connector (skopiuj token)
CLOUDFLARE_TUNNEL_TOKEN=
# ID tunelu (gdy używasz credentials-file zamiast tokena)
# TUNNEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# TUNNEL_NAME=seedinfer

# --- Opcjonalnie: Cloudflare API (gdy Caddy używa DNS challenge dla TLS bez Tunnela) ---
# CLOUDFLARE_API_TOKEN=

# --- Gateway: lokalny provider (Tailnet RTX 5090 NVFP4) ---
# Dla dev: VLLM_URL=http://127.0.0.1:47900 lub http://100.x.y.z:47901 (Tailnet IP providera, host 47900:8000/47901:3001). Można nadpisać env VLLM_PORT/AGENT_PORT.
# Na produkcji Orange Pi gateway wykrywa verified provider z lib/providers-store (heartbeat tailscale_ip:47901, vLLM wewnętrzny 8000, host 47900)
# VLLM_URL ma priorytet jeśli ustawione — nadpisuje auto-discovery
# VLLM_URL=http://100.64.0.10:47901
# LOCAL_VLLM_URL=http://127.0.0.1:47900
# SEEDINFER_VLLM_URL=http://127.0.0.1:47900
# Wewnątrz kontenera vLLM nasłuchuje na 8000 (host 47900:8000), agent na 3001 (host 47901:3001) — można nadpisać env
# Alternatywnie jeśli wolisz 41000/41001 też ok, ale domyślnie seedinfer-specific 47900/47901 (rzadki, nie koliduje z 3000/3002/8004-8007)

# --- Fallback proxy chain (Orange Pi gateway :3002) ---
# Kolejność: local → NIM → Opencode → OpenRouter → Modal (cold start 2min)
# Nowa logika (Orange Pi): local fail (brak verified lub timeout/5xx/429) → fire-and-forget warmup Modal (parallel, MODAL_WARMUP=true)
#   → sequential NIM → opencode → openrouter (30s każdy) → dopiero jeśli wszystkie fail → await Modal (120s).
#   Warmup: GET {MODAL_BASE_URL}/health lub /v1/models z MODAL_API_KEY, bez blokowania, log "[chat] modal warmup triggered".
#   Jeśli MODAL_BASE_URL pusty → skip warmup (log). Circuit breaker 5 fails → 60s cooldown.

# 1) Nvidia NIM Nemotron Lightning — https://integrate.api.nvidia.com/v1
#    Model wybrany: nvidia/nemotron-3-nano-30b-a3b (30B A3B, 1000k ctx, 3.6B active) — najbliższy seedi nfer/nemotron-lightning-1m (nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4, 30B A3B, 1M ctx).
#    Alternatywa nvidia/nvidia-nemotron-nano-9b-v2 to 9B Hybrid Mamba, 128k ctx — mniej kompatybilny, zachowany jako fallback env NIM_MODEL.
#    API key z https://build.nvidia.com (nvapi-...)
NIM_API_KEY=
# NVAPI_KEY=  # alias — wklej realny klucz do NIM_API_KEY, nie commituj (placeholder NVAPI_KEY=...)
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=nvidia/nemotron-3-nano-30b-a3b
# Alternatywa: NIM_MODEL=nvidia/nvidia-nemotron-nano-9b-v2

# 2) Opencode Zen free — env OPENCODE_BASE_URL + OPENCODE_API_KEY (alias OPENCODE_ZEN_KEY)
#    Domyślnie: gdy OPENCODE_ZEN_KEY (sk-...) → https://opencode.ai/zen/v1, else https://opencode.ai/api/v1
#    Alt: https://api.opencode.ai/v1 via env jeśli URL się różni. Alias: OPENCODE_ZEN_KEY → OPENCODE_API_KEY (kompatybilność z host PC).
#    Model: deepseek-v4-flash (default dla Zen, tiers zen model deepseek-v4-flash) lub nvidia/nemotron-3-nano-30b-a3b via override
#    Decyzja: deepseek-v4-flash wybrany jako gwarantowany free tier Zen; nemotron-3-lightning-free przywróć via OPENCODE_MODEL jeśli dostępny
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# OPENCODE_BASE_URL=https://opencode.ai/api/v1
# OPENCODE_BASE_URL=https://api.opencode.ai/v1
OPENCODE_API_KEY=
# Alias dla Pi /opt/seedinfer/.env gdy klucz znaleziony na host PC jako OPENCODE_ZEN_KEY (sk-QdAkQVR...):
OPENCODE_ZEN_KEY=
# Model: deepseek-v4-flash dla Zen (default), override dla Nemotron:
# OPENCODE_MODEL=deepseek-v4-flash
# OPENCODE_MODEL=nvidia/nemotron-3-nano-30b-a3b
# OPENCODE_MODEL=nemotron-3-lightning-free
OPENCODE_MODEL=deepseek-v4-flash

# 3) OpenRouter free nemotron — https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
# Alternatywa: OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
OPENROUTER_REFERER=https://seedinfer.com
OPENROUTER_TITLE=SeedInfer Gateway

# 4) Modal A100 on-demand drugi node — uruchamiany gdy 1-3 fail (cold start ~2min)
#    Nowa logika: gdy local fail (brak verified/timeout/5xx/429) → MODAL_WARMUP=true (default true) → fire-and-forget GET {MODAL_BASE_URL}/health lub /v1/models
#    Jeśli MODAL_BASE_URL pusty → skip warmup (log "[chat] modal warmup skipped (no MODAL_BASE_URL)"); jeśli MODAL_WARMUP=false → skip
#    Następnie sequential NIM→opencode→openrouter (30s); dopiero jeśli wszystkie fail → await Modal chat completion (120s)
#    Dzięki warmup, Modal może już być gorący i odpowiedź będzie szybka; jeśli cold start → hint "Modal cold start ~2min"
MODAL_BASE_URL=
# np. https://modal-seedinfer--nemotron-app.modal.run  lub https://seedinfer-modal.example.com
MODAL_API_KEY=
MODAL_WARMUP=true
MODAL_MODEL=seedinfer/nemotron-lightning-1m
MODAL_TIMEOUT_MS=120000

# --- Fallback tuning ---
# Timeouts: local connect ~8s intent, total 60s; fallbacks 30s; modal 120s (cold start)
LOCAL_TIMEOUT_MS=60000
FALLBACK_TIMEOUT_MS=30000
FALLBACK_LATENCY_THRESHOLD_MS=10000
FALLBACK_FAIL_THRESHOLD=5
FALLBACK_COOLDOWN_MS=60000

# --- RAM-first SQLite (tmpfs + NVMe snapshot) ---
DATABASE_URL=file:/dev/shm/seedinfer.db
SNAPSHOT_PATH=/mnt/nvme/seedinfer/snapshot.db
SNAPSHOT_INTERVAL_MS=30000

# --- Auth (JWT HS256 via jose + bcrypt) ---
AUTH_SECRET=change-me-to-64-char-random-secret-please-use-openssl-rand-base64-32
BCRYPT_ROUNDS=12
AUTH_JWT_EXPIRY=7d
SESSION_COOKIE_NAME=seedinfer_session

# --- Payments (multi-chain crypto — EVM + Solana) ---
PAYMENT_ADDRESS=0x2EB9104AEeF7270fe639Bf1965B94Bfb8Edcf786
SOLANA_ADDRESS=So11111111111111111111111111111111111111112
RPC_URL_ETH=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_ARBITRUM=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BASE=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_BNB=https://bsc-dataseed.binance.org
RPC_URL_HYPEREVM=https://rpc.hyperliquid.xyz/evm
RPC_URL_SOLANA=https://api.mainnet-beta.solana.com
RPC_FALLBACK_ETH=
RPC_FALLBACK_ARBITRUM=
RPC_FALLBACK_POLYGON=
RPC_FALLBACK_BASE=
RPC_FALLBACK_BNB=
RPC_FALLBACK_HYPEREVM=
RPC_FALLBACK_SOLANA=
CONFIRMATIONS_ETH=12
CONFIRMATIONS_ARBITRUM=24
CONFIRMATIONS_POLYGON=128
CONFIRMATIONS_BASE=24
CONFIRMATIONS_BNB=15
CONFIRMATIONS_HYPEREVM=2
CONFIRMATIONS_SOLANA=32
INVOICE_TTL_MIN=30
ALLOWED_TOKENS_ETH=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48,0xdAC17F958D2ee523a2206206994597C13D831ec7
ALLOWED_TOKENS_ARBITRUM=0xFF970A61A04b1cA14834A43f5dE4533eBDDB5CC8
ALLOWED_TOKENS_POLYGON=0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174
ALLOWED_TOKENS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
ALLOWED_TOKENS_BNB=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d
ALLOWED_TOKENS_HYPEREVM=
ALLOWED_TOKENS_SOLANA=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
WORKER_POLL_MS=15000
WORKER_CONCURRENCY=3
INVOICE_AMOUNT_TOLERANCE_BPS=50

# --- Deploy ---
# Używane przez scripts/deploy-orange-pi.sh
PI_HOST=192.168.1.50
PI_USER=seedinfer
REMOTE_DIR=/opt/seedinfer
